{
  "name": "agentilogue",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "setup": "node scripts/check-runtimes.cjs && bun install --frozen-lockfile",
    "preinstall": "node scripts/check-runtimes.cjs",
    "predev": "node scripts/check-runtimes.cjs",
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "prebuild": "node scripts/check-runtimes.cjs",
    "build": "next build",
    "prestart": "node scripts/check-runtimes.cjs",
    "start": "next start --hostname 127.0.0.1",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "pretest": "node scripts/check-runtimes.cjs",
    "test": "bun test ./app ./lib ./scripts ./tests --pass-with-no-tests",
    "assistant-ui:drift-check": "bun scripts/assistant-ui-drift.ts",
    "opencode:acp-proof": "bun scripts/opencode-acp-proof.ts",
    "premodels:check": "node scripts/check-runtimes.cjs",
    "models:check": "bun scripts/models.ts check",
    "premodels:sync": "node scripts/check-runtimes.cjs",
    "models:sync": "bun scripts/models.ts sync",
    "lint:fix": "oxlint --fix && oxfmt",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@ai-sdk/openai": "^4.0.66",
    "@assistant-ui/ai-sdk": "0.0.11",
    "@assistant-ui/react": "0.15.33",
    "@assistant-ui/react-markdown": "0.14.24",
    "@assistant-ui/react-opencode": "0.2.30",
    "@base-ui/react": "^1.8.0",
    "@opencode-ai/sdk": "1.18.35",
    "ai": "^7.0.101",
    "assistant-stream": "0.3.56",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.13",
    "zod": "4.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@assistant-ui/next": "0.0.24",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@assistant-ui/core": "0.3.33",
    "@assistant-ui/store": "0.3.23",
    "@assistant-ui/tap": "0.9.25",
    "assistant-stream": "0.3.56"
  },
  "engines": {
    "bun": ">=1.4.4 <2",
    "node": ">=24.22.1 <25"
  },
  "packageManager": "bun@1.4.4"
}
